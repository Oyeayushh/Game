# ─────────────────────────────────────────────
#  MadaraDefaultr – Environment Variables
#  Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Get from https://my.telegram.org/apps
API_ID=123456
API_HASH=your_api_hash_here

# Get from @BotFather on Telegram
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional – leave blank to use default SQLite path
# DATABASE_PATH=madara.db

# ── Chatbot (required for /chatbot on|off) ─────────────────────────────────
# MongoDB connection string – get a free cluster at https://cloud.mongodb.com
MONGO_URI=

# Optional – AI replies via GROQ. Leave blank for simple canned replies.
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Logging / Broadcast ─────────────────────────────────────────────────────
# Chat/channel id where "bot started" and "added to group" logs are sent.
# Add your bot as admin there and get the id via @userinfobot / @RawDataBot.
LOGGER_ID=
OWNER_ID=123456789

# Your personal Telegram user id — only this id can use /broadcast.
OWNER_ID=